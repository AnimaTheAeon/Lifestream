package="Lifestream"
version="@VERSION@"
os_min_ver="7.2.1-69057"
displayname="Lifestream"
description="Torrent client with a classic JRPG menu look that runs behind Barrier (the VPN container) at all times, in Container Manager. Kill switch, RSS, self-updating; controlled from a web page. Midgar and Turks can use it as their download client."
install_dep_packages="ContainerManager>=20.10.23-1432"
maintainer="AnimaTheAeon"
maintainer_url="https://github.com/AnimaTheAeon/Lifestream"
support_url="https://github.com/AnimaTheAeon/Lifestream/issues"
arch="x86_64 r1000 v1000 geminilake apollolake denverton broadwell broadwellnk broadwellnkv2 broadwellntbap purley epyc7002 avoton braswell bromolow cedarview grantley kvmx64"
dsmuidir="ui"
dsmappname="Lifestream.Web"
adminport="9091"
adminprotocol="http"
adminurl="/"
thirdparty="yes"
ctl_stop="yes"
startable="yes"
silent_install="no"
silent_upgrade="yes"
silent_uninstall="yes"
beta="no"
