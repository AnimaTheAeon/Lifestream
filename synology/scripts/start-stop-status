#!/bin/sh
# DSM service control for Lifestream (headless).
APP="$SYNOPKG_PKGDEST/app"
DATA="$SYNOPKG_PKGVAR"
PID_FILE="$DATA/lifestream.pid"
STOP_FILE="$DATA/Lifestream/stop-request"

is_running() {
	[ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

case "$1" in
	start)
		is_running && exit 0
		export HOME="$DATA"
		export XDG_CONFIG_HOME="$DATA"
		mkdir -p "$DATA/Lifestream"
		rm -f "$STOP_FILE"
		# A copy left over from before (lost PID file) would hold the port and files.
		for p in $(pidof lifestream 2>/dev/null); do
			if [ "$(readlink "/proc/$p/exe" 2>/dev/null)" = "$APP/lifestream" ]; then
				kill -TERM "$p" 2>/dev/null
				sleep 2
				kill -KILL "$p" 2>/dev/null
			fi
		done
		cd "$APP" || { echo "Lifestream's program folder is missing ($APP)." >> "$SYNOPKG_TEMP_LOGFILE"; exit 1; }
		echo "--- start $(date) ---" >> "$DATA/service.out"
		nohup "$APP/lifestream" >> "$DATA/service.out" 2>&1 < /dev/null &
		echo $! > "$PID_FILE"
		# Give it a few seconds: it must still be alive to count as started.
		i=0
		while [ $i -lt 3 ]; do
			sleep 1
			is_running || break
			i=$((i + 1))
		done
		is_running && exit 0
		# Say why in the Package Center message, not just "failed".
		if [ -n "$SYNOPKG_TEMP_LOGFILE" ]; then
			{
				echo "<p><b>Lifestream stopped right after starting.</b> What it said:</p><pre>"
				tail -n 12 "$DATA/service.out" 2>/dev/null | sed 's/&/\&amp;/g; s/</\&lt;/g'
				tail -n 8 "$DATA/Lifestream/lifestream.log" 2>/dev/null | sed 's/&/\&amp;/g; s/</\&lt;/g'
				echo "</pre>"
			} >> "$SYNOPKG_TEMP_LOGFILE"
		fi
		rm -f "$PID_FILE"
		exit 1
		;;
	stop)
		if is_running; then
			PID="$(cat "$PID_FILE")"
			# Ask nicely so download progress is saved, then insist.
			touch "$STOP_FILE"
			i=0
			while [ $i -lt 40 ] && kill -0 "$PID" 2>/dev/null; do
				sleep 0.5
				i=$((i + 1))
			done
			kill -TERM "$PID" 2>/dev/null
			sleep 1
			kill -KILL "$PID" 2>/dev/null
		fi
		rm -f "$PID_FILE" "$STOP_FILE"
		exit 0
		;;
	status)
		is_running && exit 0
		exit 3
		;;
	log)
		echo "$DATA/Lifestream/lifestream.log"
		exit 0
		;;
esac
exit 0
