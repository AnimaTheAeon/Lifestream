#!/bin/sh
# Lifestream runs in Container Manager (the "lifestream" project, inside
# Barrier's network). DSM starts and stops that project together with the
# package, so there's nothing to run here.
FLAG="$SYNOPKG_PKGVAR/.started"
case "$1" in
	start) touch "$FLAG"; exit 0 ;;
	stop) rm -f "$FLAG"; exit 0 ;;
	status) [ -f "$FLAG" ] && exit 0; exit 3 ;;
	log) echo "$SYNOPKG_PKGVAR/Lifestream/lifestream.log"; exit 0 ;;
esac
exit 0
